# Sandbox image for running untrusted, LLM-generated analysis code.
# Build once, then start a throwaway container from it per execution.
#
# This file controls WHAT IS INSIDE the image (OS, Python, libraries,
# and the non-root user). The runtime limits (no network, memory and
# CPU caps, read-only filesystem, timeout) are applied later by the
# executor as "docker run" flags, not here.

# Official slim Python image matching the project's Python version.
# "slim" is a smaller base with fewer preinstalled packages.
FROM python:3.12-slim

# Matplotlib must run without a display (there is no screen in a
# container). "Agg" is the headless backend that writes images to
# files instead of a window.
ENV MPLBACKEND=Agg

# The data-analysis libraries the sandboxed code is allowed to use.
# Versions are pinned so the sandbox is reproducible and does not
# silently change when upstream releases a new version.
# --no-cache-dir keeps the image smaller by not storing the download cache.
RUN pip install --no-cache-dir \
    pandas==2.2.3 \
    numpy==2.1.3 \
    matplotlib==3.9.2 \
    seaborn==0.13.2

# Create a non-root user. Code will run as this user, so even inside
# the container it has no administrator rights. uid 1000 is a normal
# first-user id; --create-home gives it a writable home directory.
RUN useradd --create-home --uid 1000 sandbox

# Where the mounted dataset and the code will live inside the container.
WORKDIR /workspace

# From here on, everything runs as the non-root user, not root.
USER sandbox
